{
  "dataset": "random-range-2048-angular-no-filters",
  "iterations": 100,
  "seed": 1,
  "index_types": ["HNSW", "AUTOINDEX", "IVF_PQ"],
  "tune_knobs": ["dataCoord*segment*sealProportion",
   "dataCoord*segment*maxSize",
   "efConstruction", 
   "nlist", 
   "dataNode*segment*insertBufSize", 
   "nprobe", 
   "rootCoord*minSegmentSizeToEnableIndex", 
   "common*gracefulTime", 
   "m", 
   "nbits"],
  "overrides": {
    "dataCoord*segment*sealProportion": {"min": 0.01, "max": 0.99},
    "dataCoord*segment*maxSize": {"min": 100, "max": 10000},
    "efConstruction": {"min": 256, "max": 257},
    "nlist": {"min": 128, "max": 3000},
    "dataNode*segment*insertBufSize": {"min": 100, "max": 10000000000},
    "nprobe": {"min": 8, "max": 90},
    "rootCoord*minSegmentSizeToEnableIndex": {"min": 100, "max": 10000},
    "common*gracefulTime": {"min": 100, "max": 100000},
    "m": {"enum_values": [8]},
    "nbits": {"min": 8, "max": 9},
    "reorder_k": {"min": 101, "max": 500}
  }
}




