{
  "dataset": "arxiv-titles-384-angular-no-filters",
  "iterations": 100,
  "seed": 1,
  "index_types": ["SCANN", "AUTOINDEX","IVF_PQ", "HNSW"],
  "tune_knobs": ["nbits",
    "M",
    "rootCoord*minSegmentSizeToEnableIndex",
    "dataCoord*segment*maxSize",
    "common*gracefulTime",
    "reorder_k",
    "ef",
    "nprobe",
    "nlist",
    "m",
    "efConstruction"
  ],
  "overrides": {
    "nbits": {"min": 8, "max": 9},
    "M": {"min": 32, "max": 64},
    "rootCoord*minSegmentSizeToEnableIndex": {"min": 100, "max": 10000},
    "dataCoord*segment*maxSize": {"min": 100, "max": 100000},
    "common*gracefulTime": {"min": 100, "max": 100000},
    "reorder_k": {"min": 100, "max": 1000},
    "ef": {"min": 100, "max": 501},
    "nprobe": {"min": 35, "max": 10000},
    "nlist": {"min": 651, "max": 10000},
    "m": {"enum_values": [16]},
    "efConstruction": {"min": 100, "max": 501}
  }
}




